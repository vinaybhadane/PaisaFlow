# ==============================================================================
# PaisaFlow — Environment Configuration Template
# ==============================================================================
# Security Notice:
# Never commit actual credentials, connection strings, or API keys into git.
# All financial data used in PaisaFlow must be synthetic demo data.
# ==============================================================================

# Application Environment
APP_ENV=development
PROJECT_NAME="PaisaFlow"

# Database Configuration (Supabase PostgreSQL / Local PostgreSQL)
# Format: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/paisaflow

# Cache & Message Broker (Optional Redis for Celery background tasks)
REDIS_URL=redis://localhost:6379/0

# AI Configuration (Google Gemini 3.5 Flash Lite)
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Supabase Cloud Configuration (Free Tier PostgreSQL & Storage)
SUPABASE_URL=https://<your_project_ref>.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# API & Security
API_V1_STR=/api/v1
SESSION_SECRET=generate_a_secure_random_string_for_production
CORS_ORIGINS=["http://localhost:3000"]

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_ENV=development

# Optional UI Library License (Unlumen UI Pro components only; free components do not require this)
# UNLUMEN_LICENSE_KEY=your_unlumen_license_key_here

